{
  "expo": {
    "name": "Cache",
    "slug": "cache",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-no-text.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cache.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-no-text.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.cache.app"
    },
    "web": {
      "favicon": "./assets/logo-no-text.png"
    },
    "extra": {
      "eas": {
        "projectId": "1bb4e007-d615-4e95-9485-aa4065753916"
      }
    }
  }
}
